#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""UN5 online server: rooms, match-state hosting, Discord accounts, address discovery and UDP relay, in one stdlib-only
process.

    python relay_server.py --port 47500 --admin-id <DISCORD_USER_ID> [--data ./un5_server_data] [--bind 0.0.0.0]
                           [--public-url http://HOST:47500]

    Discord login (optional, nobody has to log in to play):
        DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET   environment variables (Discord Developer Portal > your application)
        UN5_PUBLIC_URL (or --public-url)           how the browser reaches this server; the redirect registered in the
                                                   portal must be  <public-url>/auth/discord/callback
        UN5_ADMIN_ID (or --admin-id)               Discord user id of the OWNER: the only account that can publish
                                                   the default match state (the PREPARE of the launcher)

Open the SAME port number for TCP and for UDP on the machine (and in its cloud firewall).

TCP <port>  (HTTP, JSON)
    GET    /rooms                      list of open rooms. Each room: {id, nick, delay, tag, sym, status,
                                       players:{host:{nick, avatar_url}, guest:{nick, avatar_url}|null},
                                       phase, ping, elapsed}
    POST   /rooms                      host: create a room        -> {id, token}
                                       (refused unless the host's match state is the server's default)
    GET    /rooms/<id>                 public info of one room
    GET    /rooms/<id>/poll?token=&status=   host: heartbeat + "did a guest join?"
    POST   /rooms/<id>/join            guest: join                -> {token, host:{addr, lan}, delay, tag, sym}
    DELETE /rooms/<id>?token=          host: close the room
    POST   /presence                   launcher of the host / guest, every ~2 s while a session runs:
                                       {role: host|guest, room (guest), phase: select|fight, ping}
                                       (Authorization: Bearer <session> is optional: with it the room shows the
                                       player's Discord avatar and name)
    HEAD|GET /blob/<tag>               the match state / symbols.json whose sha256[:16] is <tag>
    PUT    /blob/<tag>?token=          host: only answers "existing" for the default files (hosts no longer upload)

  Default match state (lives in <data>/un5/save state/):
    GET    /default                    -> {state, symbols, updated}   tags of the default files
    HEAD|GET /default/state            the default match state (.p2s)
    HEAD|GET /default/symbols          the default symbols.json
    PUT    /default/state|symbols      OWNER ONLY (Authorization: Bearer <session> of the --admin-id account)

  Accounts = the player's Discord account (see discord_server.py). A logged-in request carries
  Authorization: Bearer <session>.
    POST   /auth/discord/start         -> {state, url, expires}   the launcher opens `url` in the browser
    GET    /auth/discord/callback      where Discord redirects the browser (the server finishes the OAuth2 here)
    GET    /auth/discord/poll?state=   -> {status: pending|ok|error, token, account}
    POST   /accounts/logout            (session)
    GET    /accounts/me                (session)                  -> {id, nick, username, avatar_url, created, admin}
  `id` is the Discord user id. Name and avatar come from Discord; avatars are served by Discord's CDN. The data lives in
  <data>/accounts.json. NOTE: this server speaks plain HTTP, so put it behind TLS (a reverse proxy) if the session
  tokens must be safe from someone on the network path.

UDP <port>
    'W' + nonce      -> the public ip:port the server sees (what STUN would tell)
    'K' + token      -> "I am here" (keeps the NAT mapping open and registers the address)
    'F' + token + X  -> X is forwarded to the other player of the room (relay), wrapped as 'D' + X

Tuned for a small machine (1 core, 1 GB):
    - the UDP relay hot path takes no lock and allocates as little as possible;
    - relay traffic keeps its room alive (a long download can no longer kill a running match);
    - HTTP threads are capped, blob downloads use sendfile, the thread switch interval is short.
"""
from __future__ import annotations

import argparse
import hashlib
import ipaddress
import json
import os
import re
import secrets
import socket
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

import discord_server
from discord_server import Accounts, ApiError

MAGIC = b"UN5\xfe"
ROOM_TTL = 60.0                 # a room whose host stopped polling AND sending relay traffic disappears after this
PREP_TTL = 600.0                # ... but a room that is still uploading the match state gets longer
MAX_ROOMS = 200
MAX_ROOMS_PER_IP = 5
MAX_BLOB = 256 * 1024 * 1024
STORE_CAP = 1024 * 1024 * 1024  # unreferenced blobs are deleted (oldest first) above this total size
BLOB_TTL = 48 * 3600
MAX_PKT = 1500
PKT_PER_S = 800                 # relay packets per second per player
HTTP_THREADS = 48               # simultaneous HTTP connections served; more are dropped at once
HTTP_TIMEOUT = 15               # seconds of silence on one HTTP connection
CHUNK = 1 << 20                 # upload read size
PHASES = ("select", "fight")    # what the host's launcher can report while a match is running

TAG_RE = re.compile(r"^[0-9a-f]{16}$")
ID_RE = re.compile(r"^[0-9a-f]{8}$")
TOKEN_RE = re.compile(r"^[0-9a-f]{16}$")


def clean_nick(value):
    nick = "".join(c for c in str(value or "") if 32 <= ord(c) <= 126 and c not in "<>").strip()[:15]
    return nick or "Player"


def need_tag(value):
    value = str(value or "").lower()
    if not TAG_RE.match(value):
        raise ApiError(400, "bad tag")
    return value


def need_addr(value):
    try:
        ip, port = value
        ipaddress.IPv4Address(ip)
        port = int(port)
        if not 0 < port < 65536:
            raise ValueError
        return [str(ip), port]
    except Exception:                                  # noqa: BLE001 - anything malformed is a 400
        raise ApiError(400, "bad address") from None


def lan_list(value):
    out = []
    for item in list(value or [])[:8]:
        try:
            out.append(need_addr(item))
        except ApiError:
            pass
    return out


# ======================================================================================================================
class Store:
    def __init__(self, data_dir, discord=None, admin_id=""):
        self.lock = threading.RLock()                  # protects create / join / drop / gc (NOT the relay hot path)
        self.rooms = {}                                # id -> room
        self.tokens = {}                               # 8 raw bytes -> (room, role: 1 host / 2 guest)
        self.blobs = Path(data_dir) / "blobs"
        self.blobs.mkdir(parents=True, exist_ok=True)
        self.state_dir = Path(data_dir) / "un5" / "save state"      # the default match state lives here
        self.state_dir.mkdir(parents=True, exist_ok=True)
        self.default_lock = threading.Lock()
        self.accounts = Accounts(data_dir, discord)
        self.admin_id = str(admin_id or "").strip()
        self.accounts.admin_id = self.admin_id

    # ---- rooms -------------------------------------------------------------------------------------------------
    def _room(self, rid):
        room = self.rooms.get(rid) if ID_RE.match(str(rid)) else None
        if room is None:
            raise ApiError(404, "room not found")
        return room

    def _need_host(self, room, token):
        if not TOKEN_RE.match(str(token or "")) or not secrets.compare_digest(token, room["host"]["token"]):
            raise ApiError(403, "bad token")

    def public(self, room):
        """What anybody may see of a room. `players` carries the Discord profile (name + CDN avatar) of the host and
        the guest when their launchers reported it (see presence()); otherwise just the nick the game uses."""
        profile = self.accounts.profile
        host = profile(room["host_acc"]) or dict(nick=room["nick"], avatar_url="")
        g = room["guest"]
        guest = (profile(room["guest_acc"]) or dict(nick=g["nick"], avatar_url="")) if g else None
        started = room["started"]
        return dict(id=room["id"], nick=room["nick"], delay=room["delay"], tag=room["tag"], sym=room["sym"],
                    status=room["status"], players=dict(host=host, guest=guest), phase=room["phase"],
                    ping=room["ping"], elapsed=int(time.time() - started) if started else None)

    def gc(self):
        now = time.time()
        with self.lock:
            for rid, room in list(self.rooms.items()):
                ttl = PREP_TTL if room["status"] == "preparing" else ROOM_TTL
                if now - room["seen"] > ttl:
                    self._drop(rid)

    def _drop(self, rid):
        room = self.rooms.pop(rid, None)
        if room is None:
            return
        self.tokens.pop(bytes.fromhex(room["host"]["token"]), None)
        if room["guest"]:
            self.tokens.pop(bytes.fromhex(room["guest"]["token"]), None)

    def create(self, ip, body):
        try:
            delay = int(body.get("delay"))
        except (TypeError, ValueError):
            raise ApiError(400, "bad delay") from None
        if not 0 <= delay <= 30:
            raise ApiError(400, "bad delay")
        addr, lan = need_addr(body.get("addr")), lan_list(body.get("lan"))
        info = self.default_info()
        if not info or not info.get("state") or not info.get("symbols"):
            raise ApiError(503, "the owner has not published the default match state yet")
        tag = need_tag(body.get("tag"))
        if tag != info["state"]:
            raise ApiError(409, "your match state is not the server's default: update it and try again")
        sym = info["symbols"]                          # the room always uses the server's symbols.json
        with self.lock:
            self.gc()
            if len(self.rooms) >= MAX_ROOMS:
                raise ApiError(503, "the server is full")
            if sum(1 for r in self.rooms.values() if r["creator"] == ip) >= MAX_ROOMS_PER_IP:
                raise ApiError(429, "too many rooms from your address")
            rid = secrets.token_hex(4)
            while rid in self.rooms:
                rid = secrets.token_hex(4)
            token = secrets.token_hex(8)
            now = time.time()
            room = dict(id=rid, nick=clean_nick(body.get("nick")), delay=delay, tag=tag, sym=sym,
                        status="preparing", creator=ip, seen=now, created=now, gen=0, guest=None,
                        host=dict(token=token, addr=addr, lan=lan), udp={1: None, 2: None},
                        rate={1: [0.0, 0], 2: [0.0, 0]},
                        host_acc=None, guest_acc=None,         # Discord ids, filled by presence()
                        phase="", ping=None, started=None)     # live info for the room list
            self.rooms[rid] = room
            self.tokens[bytes.fromhex(token)] = (room, 1)
        return dict(id=rid, token=token)

    def listing(self):
        with self.lock:
            self.gc()
            rooms = [self.public(r) for r in self.rooms.values() if r["status"] in ("waiting", "playing")]
        return dict(rooms=rooms)

    def get(self, rid):
        with self.lock:
            return self.public(self._room(rid))

    def poll(self, rid, token, status):
        with self.lock:
            room = self._room(rid)
            self._need_host(room, token)
            if status in ("preparing", "waiting", "playing"):
                if status == "playing" and room["status"] != "playing":
                    room["started"] = time.time()              # the match clock of the room list starts here
                elif status != "playing":
                    room["started"], room["phase"], room["ping"] = None, "", None
                room["status"] = status
            room["seen"] = time.time()
            g = room["guest"]
            guest = dict(addr=g["addr"], lan=g["lan"], nick=g["nick"], gen=room["gen"]) if g else None
            return dict(status=room["status"], guest=guest)

    def join(self, rid, body):
        with self.lock:
            room = self._room(rid)
            if room["status"] != "waiting":
                raise ApiError(409, "the room is not open")
            addr, lan = need_addr(body.get("addr")), lan_list(body.get("lan"))
            old = room["guest"]
            if old:
                self.tokens.pop(bytes.fromhex(old["token"]), None)
            token = secrets.token_hex(8)
            room["guest"] = dict(token=token, addr=addr, lan=lan, nick=clean_nick(body.get("nick")))
            room["guest_acc"] = None                           # the new guest's launcher claims it in presence()
            room["gen"] += 1
            room["udp"][2] = None
            room["rate"][2] = [0.0, 0]
            self.tokens[bytes.fromhex(token)] = (room, 2)
            return dict(id=rid, token=token, delay=room["delay"], tag=room["tag"], sym=room["sym"],
                        host=dict(addr=room["host"]["addr"], lan=room["host"]["lan"], nick=room["nick"]))

    def delete(self, rid, token):
        with self.lock:
            room = self._room(rid)
            self._need_host(room, token)
            self._drop(rid)

    def is_host_token(self, token):
        if not TOKEN_RE.match(str(token or "")):
            return False
        ent = self.tokens.get(bytes.fromhex(token))
        return bool(ent and ent[1] == 1)

    def presence(self, ip, session, body):
        """The launcher of a player tells the server who it is and what the match is doing (phase, ping).
        The netplay process owns the room token, so the launcher is linked to the room by address instead:
          host  -> the newest room created from the same IP
          guest -> the room named in the body, if the caller's IP is the one that joined it
        The phase is only taken from the host (it is the authority); the ping from either side."""
        role = body.get("role")
        if role not in ("host", "guest"):
            raise ApiError(400, "bad role")
        aid = None
        if session:
            try:
                aid = self.accounts.auth(session)
            except ApiError:
                aid = None                                     # an expired login still reports phase / ping
        phase = body.get("phase")
        if phase is not None and phase not in PHASES:
            raise ApiError(400, "bad phase")
        ping = body.get("ping")
        if ping is not None:
            try:
                ping = int(ping)
            except (TypeError, ValueError):
                raise ApiError(400, "bad ping") from None
            if not 0 <= ping <= 9999:
                ping = None
        with self.lock:
            if role == "host":
                mine = [r for r in self.rooms.values() if r["creator"] == ip]
                if not mine:
                    raise ApiError(404, "no room from your address")
                room = max(mine, key=lambda r: r["created"])
                if aid:
                    room["host_acc"] = aid
                if phase and room["status"] == "playing":
                    room["phase"] = phase
            else:
                room = self._room(body.get("room"))
                g = room["guest"]
                if not g or g["addr"][0] != ip:
                    raise ApiError(403, "you are not the guest of this room")
                if aid:
                    room["guest_acc"] = aid
            if ping is not None and room["status"] == "playing":
                room["ping"] = ping
        return dict(ok=True)

    # ---- relay -------------------------------------------------------------------------------------------------
    def relay_target(self, token, addr, forward):
        """Register `addr` as the current UDP address of this token's player. Returns the other player's address.
        Hot path: no lock. Single dict reads / item stores are atomic under the GIL, and a stale answer for one packet
        around a join or a drop is harmless (UDP, the protocol retransmits)."""
        ent = self.tokens.get(token)
        if ent is None:
            return None
        room, role = ent
        win = room["rate"][role]
        now = time.monotonic()
        if now - win[0] >= 1.0:
            win[0], win[1] = now, 0
            room["seen"] = time.time()                 # traffic keeps the room alive (checked once per second)
        win[1] += 1
        if win[1] > PKT_PER_S:
            return None
        udp = room["udp"]
        udp[role] = addr
        return udp.get(3 - role) if forward else None

    # ---- default match state (only the owner publishes it) -----------------------------------------------------
    def default_path(self, kind):
        return self.state_dir / ("default.p2s" if kind == "state" else "default.symbols.json")

    def default_info(self):
        try:
            info = json.loads((self.state_dir / "default.json").read_text("utf-8"))
            return info if isinstance(info, dict) else None
        except (OSError, ValueError):
            return None

    def need_admin(self, session):
        if not self.admin_id:
            raise ApiError(503, "no owner is configured on this server (--admin-id)")
        if self.accounts.auth(session) != self.admin_id:      # raises 401 if not logged in
            raise ApiError(403, "only the owner can publish the match state")

    def set_default(self, kind, tmp, tag):
        with self.default_lock:
            os.replace(tmp, self.default_path(kind))
            info = self.default_info() or {}
            info[kind] = tag
            info["updated"] = int(time.time())
            meta = self.state_dir / "default.json"
            part = meta.with_suffix(".tmp")
            part.write_text(json.dumps(info), "utf-8")
            os.replace(part, meta)

    def blob_file(self, tag):
        """/blob/<tag>: the default state and symbols are served from the 'save state' folder."""
        tag = need_tag(tag)
        info = self.default_info()
        if info:
            if tag == info.get("state"):
                return self.default_path("state")
            if tag == info.get("symbols"):
                return self.default_path("symbols")
        return self.blobs / tag

    # ---- blobs -------------------------------------------------------------------------------------------------
    def trim(self):
        now = time.time()
        with self.lock:
            live = set()
            for r in self.rooms.values():
                live.add(r["tag"])
                live.add(r["sym"])
        files = []
        for p in self.blobs.iterdir():
            try:
                st = p.stat()
            except OSError:
                continue
            if p.suffix == ".part":
                if now - st.st_mtime > 3600:
                    p.unlink(missing_ok=True)
                continue
            if p.name in live:
                continue
            if now - st.st_mtime > BLOB_TTL:
                p.unlink(missing_ok=True)
                continue
            files.append((st.st_mtime, st.st_size, p))
        total = sum(sz for _m, sz, _p in files)
        for _m, sz, p in sorted(files, key=lambda x: x[0]):
            if total <= STORE_CAP:
                break
            p.unlink(missing_ok=True)
            total -= sz


# ======================================================================================================================
class LimitedServer(ThreadingHTTPServer):
    """ThreadingHTTPServer with a cap on simultaneous connections: on a 1 GB machine a few hundred slow clients would
    otherwise eat the memory and the CPU the UDP relay needs."""
    request_queue_size = 64
    daemon_threads = True
    _slots = threading.BoundedSemaphore(HTTP_THREADS)

    def process_request(self, request, client_address):
        if not self._slots.acquire(blocking=False):
            self.shutdown_request(request)             # busy: drop it, the client retries
            return
        try:
            super().process_request(request, client_address)
        except Exception:                              # noqa: BLE001 - thread could not start
            self._slots.release()
            raise

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self._slots.release()


class Handler(BaseHTTPRequestHandler):
    server_version = "UN5Server/1"
    timeout = HTTP_TIMEOUT
    store: Store

    def log_message(self, fmt, *args):                 # quiet: one line per error only
        pass

    def _send(self, code, payload, ctype="application/json", head=False):
        data = payload if isinstance(payload, bytes) else json.dumps(payload).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        if not head:
            self.wfile.write(data)

    def _body(self):
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            raise ApiError(400, "bad Content-Length") from None
        if not 0 <= length <= 8192:
            raise ApiError(413, "body too large")
        try:
            return json.loads(self.rfile.read(length).decode("utf-8") or "{}")
        except ValueError:
            raise ApiError(400, "bad JSON") from None

    def _dict_body(self):
        body = self._body()
        if not isinstance(body, dict):
            raise ApiError(400, "bad JSON")
        return body

    def _session_token(self):
        header = self.headers.get("Authorization", "")
        return header[7:].strip() if header.startswith("Bearer ") else ""

    def _handle(self, method):
        try:
            self._route(method)
        except ApiError as error:
            self.close_connection = True
            self._send(error.code, dict(error=error.message))
        except (BrokenPipeError, ConnectionResetError, socket.timeout):
            self.close_connection = True
        except Exception as exc:                       # noqa: BLE001
            self.close_connection = True
            print(f"[http] {method} {self.path}: {exc!r}", flush=True)
            try:
                self._send(500, dict(error="server error"))
            except OSError:
                pass

    do_GET = lambda self: self._handle("GET")          # noqa: E731
    do_POST = lambda self: self._handle("POST")        # noqa: E731
    do_PUT = lambda self: self._handle("PUT")          # noqa: E731
    do_DELETE = lambda self: self._handle("DELETE")    # noqa: E731
    do_HEAD = lambda self: self._handle("HEAD")        # noqa: E731

    def _route(self, method):
        url = urlparse(self.path)
        parts = [p for p in url.path.split("/") if p]
        q = {k: v[0] for k, v in parse_qs(url.query).items()}
        st = self.store
        if not parts or parts == ["health"]:
            return self._send(200, b"UN5 server\n", "text/plain", head=(method == "HEAD"))
        if parts[0] == "rooms":
            if len(parts) == 1:
                if method == "GET":
                    return self._send(200, st.listing())
                if method == "POST":
                    return self._send(200, st.create(self.client_address[0], self._dict_body()))
            elif len(parts) == 2:
                if method == "GET":
                    return self._send(200, st.get(parts[1]))
                if method == "DELETE":
                    st.delete(parts[1], q.get("token"))
                    return self._send(200, dict(ok=True))
            elif len(parts) == 3:
                if parts[2] == "poll" and method == "GET":
                    return self._send(200, st.poll(parts[1], q.get("token"), q.get("status")))
                if parts[2] == "join" and method == "POST":
                    return self._send(200, st.join(parts[1], self._dict_body()))
        elif parts[0] == "presence" and len(parts) == 1 and method == "POST":
            return self._send(200, st.presence(self.client_address[0], self._session_token(), self._dict_body()))
        elif parts[0] == "blob" and len(parts) == 2:
            if method in ("GET", "HEAD"):
                return self._blob_get(parts[1], head=(method == "HEAD"))
            if method == "PUT":
                return self._blob_put(parts[1], q.get("token"))
        elif parts[0] == "default":
            if len(parts) == 1 and method == "GET":
                info = st.default_info()
                if not info:
                    raise ApiError(404, "no default match state yet")
                return self._send(200, info)
            if len(parts) == 2 and parts[1] in ("state", "symbols"):
                if method in ("GET", "HEAD"):
                    return self._send_file(st.default_path(parts[1]), head=(method == "HEAD"))
                if method == "PUT":
                    return self._default_put(parts[1])
        elif parts[0] in ("accounts", "auth"):
            return discord_server.route(self, method, parts, q)       # Discord login, session, profile
        raise ApiError(404, "not found")

    # ---- files -------------------------------------------------------------------------------------------------
    def _send_file(self, path, head):
        try:
            size = path.stat().st_size
        except OSError:
            raise ApiError(404, "not found") from None
        os.utime(path, None)                           # still wanted: keep it from the cleanup
        self.send_response(200)
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("Content-Length", str(size))
        self.end_headers()
        if head:
            return
        self.wfile.flush()
        with open(path, "rb") as f:
            self.connection.sendfile(f)                # zero-copy: almost no CPU, no GIL while the kernel copies

    def _blob_get(self, tag, head):
        self._send_file(self.store.blob_file(tag), head)

    def _blob_put(self, tag, token):
        """Hosts no longer upload states: a tag that is already the default answers 'existing', anything else is
        refused."""
        if not self.store.is_host_token(token):
            raise ApiError(403, "bad token")
        if self.store.blob_file(tag).exists():
            self.close_connection = True
            return self._send(200, dict(ok=True, existing=True))
        raise ApiError(403, "only the default match state is accepted; the owner publishes it")

    def _receive(self, tmp, length):
        digest = hashlib.sha256()
        left = length
        with open(tmp, "wb") as f:
            while left > 0:
                chunk = self.rfile.read(min(CHUNK, left))
                if not chunk:
                    raise ApiError(400, "upload interrupted")
                digest.update(chunk)
                f.write(chunk)
                left -= len(chunk)
        return digest.hexdigest()[:16]

    def _default_put(self, kind):
        st = self.store
        st.need_admin(self._session_token())
        try:
            length = int(self.headers.get("Content-Length", "-1"))
        except ValueError:
            length = -1
        if length <= 0:
            raise ApiError(411, "Content-Length required")
        if length > MAX_BLOB:
            raise ApiError(413, f"file too large (limit {MAX_BLOB // 1048576} MB)")
        tmp = st.state_dir / f"{kind}.{secrets.token_hex(4)}.part"
        try:
            tag = self._receive(tmp, length)
            st.set_default(kind, tmp, tag)
        finally:
            tmp.unlink(missing_ok=True)
        self._send(200, dict(ok=True, tag=tag))


# ======================================================================================================================
def udp_loop(store, sock):
    buf = bytearray(2048)                              # one fixed buffer: no allocation per received packet
    view = memoryview(buf)
    relay_target = store.relay_target
    sendto = sock.sendto
    magic_d = MAGIC + b"D"
    while True:
        try:
            n, addr = sock.recvfrom_into(buf)
        except ConnectionResetError:                   # Windows: ICMP from a client that went away
            continue
        except OSError:
            return
        if n < 5 or view[:4] != MAGIC:
            continue
        kind = buf[4]
        try:
            if kind == 0x46 and 13 <= n <= MAX_PKT + 13:       # 'F': relay (by far the most common)
                other = relay_target(bytes(view[5:13]), addr, True)
                if other:
                    sendto(magic_d + bytes(view[13:n]), other)
            elif kind == 0x4B and 13 <= n <= MAX_PKT + 13:     # 'K': keepalive / register address
                relay_target(bytes(view[5:13]), addr, False)
            elif kind == 0x57 and n >= 21:                     # 'W': what is my public address
                sendto(MAGIC + b"W" + bytes(view[5:21]) + f"{addr[0]}:{addr[1]}".encode("ascii"), addr)
        except OSError:
            pass


def janitor(store):
    n = 0
    while True:
        time.sleep(5)
        store.gc()
        n += 1
        if n % 12 == 0:
            try:
                store.trim()
                store.accounts.gc()
            except OSError:
                pass


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--port", type=int, default=47500, help="TCP (HTTP) and UDP port, the same number for both")
    ap.add_argument("--bind", default="0.0.0.0")
    ap.add_argument("--data", default="un5_server_data", help="folder for the shared match states and accounts")
    ap.add_argument("--public-url", default=os.environ.get("UN5_PUBLIC_URL", ""),
                    help="how browsers reach this server, e.g. http://1.2.3.4:47500 (Discord redirect = "
                         "<public-url>/auth/discord/callback)")
    ap.add_argument("--admin-id", default=os.environ.get("UN5_ADMIN_ID", ""),
                    help="Discord user id of the owner (the only one who can publish the default match state)")
    args = ap.parse_args()
    discord = dict(client_id=os.environ.get("DISCORD_CLIENT_ID", "").strip(),
                   secret=os.environ.get("DISCORD_CLIENT_SECRET", "").strip(),
                   redirect=args.public_url.rstrip("/") + "/auth/discord/callback" if args.public_url else "")
    sys.setswitchinterval(0.0005)                      # the relay thread waits at most 0.5 ms (default 5 ms) for the GIL
    store = Store(args.data, discord, args.admin_id)
    usock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    for opt in (socket.SO_RCVBUF, socket.SO_SNDBUF):   # bigger buffers absorb bursts while another thread holds the GIL
        try:
            usock.setsockopt(socket.SOL_SOCKET, opt, 1 << 20)
        except OSError:
            pass
    usock.bind((args.bind, args.port))
    if os.name == "nt":
        try:
            usock.ioctl(socket.SIO_UDP_CONNRESET, False)
        except (AttributeError, OSError):
            pass
    threading.Thread(target=udp_loop, args=(store, usock), daemon=True).start()
    threading.Thread(target=janitor, args=(store,), daemon=True).start()
    Handler.store = store
    httpd = LimitedServer((args.bind, args.port), Handler)
    login = (f"Discord login ON (redirect {discord['redirect']})" if store.accounts.configured
             else "Discord login OFF (set DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET and --public-url)")
    owner = f"owner {store.admin_id}" if store.admin_id else "NO OWNER (set --admin-id: nobody can publish the match state)"
    print(f"UN5 server on {args.bind}: TCP {args.port} (rooms, files, accounts) + UDP {args.port} (address "
          f"discovery, relay). Data: {Path(args.data).resolve()}  ({login}; {owner})", flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()
        usock.close()


if __name__ == "__main__":
    main()