# -*- coding: utf-8 -*-
"""UN5 Netplay - idiomas (English / Portugues BR).

Uso:   from i18n import tr
       tr("btn.stop")                      -> "STOP" ou "PARAR"
       tr("log.server", addr="1.2.3.4")    -> texto com {addr} preenchido

Para adicionar um idioma: coloque o codigo em LANGS e acrescente uma coluna em cada entrada de STRINGS.
Chave que nao existe no idioma atual cai para o ingles; chave que nao existe em lugar nenhum devolve a propria chave.
"""
from __future__ import annotations

import os

LANGS = {"en": "English", "pt": "Português (BR)"}      # codigo -> nome mostrado no dropdown
_ORDER = ("en", "pt")
_lang = "en"


def detect() -> str:
    """Idioma padrao: portugues se o Windows estiver em pt-*, senao ingles."""
    name = ""
    try:
        import ctypes
        buf = ctypes.create_unicode_buffer(85)
        ctypes.windll.kernel32.GetUserDefaultLocaleName(buf, 85)
        name = buf.value
    except Exception:                                  # noqa: BLE001 - nao e Windows
        name = os.environ.get("LANG", "")
    return "pt" if name.lower().startswith("pt") else "en"


def set_lang(code: str):
    global _lang
    if code in LANGS:
        _lang = code


def get_lang() -> str:
    return _lang


def has(key: str) -> bool:
    return key in STRINGS


def tr(key: str, **kw) -> str:
    entry = STRINGS.get(key)
    if entry is None:
        return key
    text = entry[_ORDER.index(_lang)] or entry[0]
    return text.format(**kw) if kw else text


